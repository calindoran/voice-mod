# Add one approved {phoneNumber, userName} pair per member. Empty means no one can sign in.
ALLOWED_USERS_JSON=[
    {"phoneNumber": "+0123456789", "userName": "EU"}
]
# Add the Expo web origin here if you run it on a different local port.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Keep this stable while community-server memberships are stored in SQLite.
USER_ID_SECRET=replace-with-a-long-random-secret
# Optional override; development defaults match compose.yaml.
# For a physical device, set both values to your computer's LAN IP.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Set APP_ENV=production and replace all development values before deployment.
